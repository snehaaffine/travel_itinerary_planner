# Database
DATABASE_URL=postgresql+psycopg://travel_planner:travel_planner@localhost:5433/travel_planner

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
APP_API_TOKEN=dev-app-token
SESSION_SECRET=dev-session-secret-change-in-production
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider (anthropic | nvidia)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron Ultra can take several minutes per request; increase if you still hit timeouts.
NVIDIA_TIMEOUT_SECONDS=300
NVIDIA_MAX_TOKENS=8192

# External APIs (Phase 1+)
GEOAPIFY_API_KEY=
TAVILY_API_KEY=

# Phase 3+
GEMINI_API_KEY=

# Phase 4+
CAMBAI_API_KEY=
